name shcomp
bin shcomp
version "0.0.2"
about "Manage shell completions that follow the active tool version"
arg_required_else_help #true
flag "-v --verbose" help="Print more detail; repeat for more" global=#true count=#true var=#true
flag "-q --quiet" help="Report errors only" global=#true
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd install help="Install and reconcile shell shims for the selected tools" {
    flag --no-fetch help="Do not fetch URL sources"
    flag --offline help="Fail instead of fetching an uncached URL source"
    flag --prewarm help="Generate scripts for the versions on PATH even when `[settings].prewarm` is false"
    flag --no-prewarm help="Do not generate scripts now; the first Tab generates them"
    flag "-n --dry-run" help="Print what would change without changing it"
    flag "-s --shell" help="Shells to reconcile; defaults to the `shells` setting" var=#true {
        arg <SHELL>
    }
    flag --json help="Machine-readable output"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd uninstall help="Remove shcomp-owned shims" {
    flag --dry-run help="Print what would be removed without removing it"
    flag "-s --shell" help="Shells to clean; defaults to the `shells` setting" var=#true {
        arg <SHELL>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd load help="Print the cached script path for one command and executable" hide=#true {
    flag --shell help="Target shell" default=zsh {
        arg <SHELL>
    }
    flag --command help="Command name as typed" required=#true {
        arg <COMMAND>
    }
    flag --bin help="Resolved executable path" required=#true {
        arg <BIN>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd complete-word help="Probe completion candidates through the target shell" {
    flag --shell help="Target shell" default=zsh {
        arg <SHELL>
    }
    flag --cword help="Index of the word being completed; defaults to the last word" {
        arg <CWORD>
    }
    flag --json help="Machine-readable output"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <TOOL> help="Tool reference, optionally with `@version`"
    arg "[WORDS]..." help="Words typed so far, starting with the command" var_max=4294967295
    complete tool run="shcomp __complete_word__ --candidates tool --line={{ words | shell_join | shell_quote }}"
}
cmd doctor help="Check the configuration and installed shims" {
    flag --check help="Run each generator and validate its output"
    flag --json help="Machine-readable output"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd ls help="List selected tools and their completion sources" {
    flag --json help="Machine-readable output"
    flag --all help="Include disabled selections"
    flag --no-header help="Do not print the table header" {
        alias --no-headers hide=#true
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd search help="Search the registry for a tool to add" {
    flag "-i --interactive" help="Pick a result from a menu and add it to the config" {
        conflicts --match-type --no-header --json
    }
    flag "-m --match-type" help="Match type: equal, contains, or fuzzy" default=fuzzy {
        arg <MATCH_TYPE> {
            choices {
                choice equal
                choice contains
                choice fuzzy
            }
        }
    }
    flag --no-header help="Do not print the table header" {
        alias --no-headers hide=#true
    }
    flag --json help="Machine-readable output"
    flag --complete help="Print every candidate with its description, for shell completions" hide=#true
    flag --complete-ids help="Print only candidate values, for shell completions" hide=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[NAME]" help="Name, workspace, or reference to search for"
    complete name run="shcomp __complete_word__ --candidates name --line={{ words | shell_join | shell_quote }}"
}
cmd add help="Add a tool selection to the config" {
    flag --alias help="Extra command name to register; repeat for several" var=#true {
        arg <ALIAS>
    }
    flag "-n --dry-run" help="Print what would change without changing anything"
    flag --dry-run-code help="With --dry-run, exit 1 when there is something to do" requires=--dry-run
    flag --no-install help="Write the selection but install nothing"
    flag "-f --force" help="Replace the selection's aliases instead of adding to them"
    flag --no-prewarm help="Do not generate the script now; the first Tab generates it"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <REFERENCE> help="Tool reference to add"
    complete reference run="shcomp __complete_word__ --candidates reference --line={{ words | shell_join | shell_quote }}"
}
cmd clean help="Remove cached completion scripts, or only the stale ones" {
    flag --stale help="Remove only scripts no `shcomp load` can reach any more"
    flag "-s --shell" help="Only this shell's scripts" {
        arg <SHELL>
    }
    flag "-n --dry-run" help="Print what would be removed without removing it"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[TOOL]..." help="Only these tools' scripts; defaults to every tool"
    complete tool run="shcomp __complete_word__ --candidates tool --line={{ words | shell_join | shell_quote }}"
}
cmd schema help="Print the JSON Schema for the config or a registry item" {
    flag --registry help="Print the registry-item schema instead of the config schema"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd usage help="Print the usage KDL for shcomp itself" {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd completion help="Print a completion script for shcomp itself" {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> help="Shell to generate completions for" {
        choices bash fish nu powershell zsh
    }
}

