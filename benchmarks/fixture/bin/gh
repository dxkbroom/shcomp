#!/bin/sh
# A stand-in for GitHub's `gh`, so the benchmark fixture never needs it
# installed. It answers whichever shell the registry item asks for.
#
# Builtins only: the benchmark replaces PATH with this directory.
case " $* " in
  *" fish "*)
    printf '%s\n' \
      "complete -c gh -f -a 'help'" \
      "complete -c gh -f -a 'issue'" \
      "complete -c gh -f -a 'pr'"
    ;;
  *)
    printf '%s\n' \
      '#compdef gh' \
      '_gh() {' \
      '  local -a commands' \
      '  commands=(' \
      "    'help:Show help for a command'" \
      "    'issue:Manage issues'" \
      "    'pr:Manage pull requests'" \
      "    'repo:Manage repositories'" \
      "    'status:Show status'" \
      '  )' \
      "  _describe -t commands 'gh command' commands" \
      '}'
    ;;
esac
