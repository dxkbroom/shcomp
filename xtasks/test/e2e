#!/usr/bin/env bash
#MISE depends=["build"]
#MISE alias=["e", "e2e"]
#MISE description="Run end-to-end tests"
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
E2E_DIR="$ROOT/e2e"

# Show help.
if [[ ${1:-} == --help ]]; then
  cat >&2 <<EOF
Usage: mise run test:e2e [OPTIONS] [TEST_PATTERNS...]

Options:
  --help     Show this help message
  --list     List all available tests
  --all      Run all tests

Arguments:
  TEST_PATTERNS...  Test patterns to run (e.g., "zsh", "install", "complete")

Examples:
  mise run test:e2e --list                    # List all available tests
  mise run test:e2e --all                     # Run all tests
  mise run test:e2e -- zsh                    # Run all zsh-related tests
  mise run test:e2e -- test_install           # Run a specific test

Environment:
  E2E_JOBS               Number of tests to run concurrently (default: min(cpus, 4))
  E2E_MAX_ATTEMPTS       Attempts per test (default: 1)
  E2E_RETRY_WAIT_SECONDS Seconds between attempts (default: 30)
  TEST_ALL=1             Include *_slow tests during discovery
EOF
  exit 0
fi

list_matching_tests() {
  local pattern="$1" file

  while IFS= read -r file; do
    if [[ ${file##*/} =~ $pattern ]]; then
      printf '%s\n' "${file#./}"
    fi
  done < <(find . -type f -name "test_*" | sort)
}

# List all available tests.
if [[ ${1:-} == --list ]]; then
  echo "Available tests:" >&2
  pushd "$E2E_DIR" >/dev/null
  find . -type f -name "test_*" | sed 's#^\./##' | sort
  popd >/dev/null
  exit 0
fi

if [[ ${1:-} == --all ]]; then
  "$E2E_DIR/run_all_tests"
else
  # Handle multiple test arguments.
  TEST_FILES=()
  for TEST_ARG in "$@"; do
    # Strip e2e/ prefix if present, then match on the filename.
    PATTERN="${TEST_ARG#e2e/}"
    FILENAME="$(basename "$PATTERN")"

    pushd "$E2E_DIR" >/dev/null
    FILES="$(list_matching_tests "$FILENAME")"
    popd >/dev/null

    if [[ -z $FILES ]]; then
      echo "No test matches $TEST_ARG" >&2
      exit 1
    fi

    for FILE in $FILES; do
      TEST_FILES+=("$FILE")
    done
  done

  # E2E_JOBS opts into running the matches concurrently, in argument order.
  if [[ -n ${E2E_JOBS:-} && ${#TEST_FILES[@]} -gt 0 ]]; then
    "$E2E_DIR/run_all_tests" "${TEST_FILES[@]}"
  else
    for FILE in ${TEST_FILES[@]+"${TEST_FILES[@]}"}; do
      echo "[e2e] Running test: $FILE" >&2
      "$E2E_DIR/run_test" "$FILE"
    done
  fi
fi
