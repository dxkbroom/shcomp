#!/usr/bin/env bash
#MISE description="Cut a GitHub release (tarballs, checksums, packslip-sign)"
#USAGE arg "<version>" help="Semver to publish (must match Cargo.toml)"
#USAGE flag "--dry-run" help="Build artifacts only; no tag, gh release, or packslip"
#USAGE flag "--host-only" help="Only build the current rustc host triple"
set -euo pipefail

task_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
source "$task_dir/lib.sh"

root="$(release_root)"
cd "$root"

version="${usage_version:?missing required arg <version>}"
dry_run="${usage_dry_run:-false}"
host_only="${usage_host_only:-false}"

if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-].+)?$ ]]; then
  echo "version must look like semver (got: $version)" >&2
  exit 2
fi

tag="v$version"
notes_file="release-notes/$version.md"
host_triple="${HOST_TRIPLE:-$(release_host_triple)}"

echo "==> publish $tag (dry_run=$dry_run host_only=$host_only)"

if [[ ! -s $notes_file ]]; then
  echo "missing or empty release notes: $notes_file" >&2
  echo "Write GitHub release notes there before publishing." >&2
  exit 1
fi

if [[ $dry_run != true ]]; then
  if [[ -n $(git status --porcelain) ]]; then
    echo "working tree is dirty; commit or stash first" >&2
    exit 1
  fi
  release_require_cmd gh
  gh auth status >/dev/null 2>&1
fi

pkg_version="$(release_version)"
if [[ $pkg_version != "$version" ]]; then
  echo "Cargo.toml version is $pkg_version but publish asked for $version" >&2
  echo "bump with: mise run release:bump <version>" >&2
  exit 1
fi

rm -rf dist
mkdir -p dist

echo "==> release assets (usage, completions, man)"
mise run release:assets

if [[ $host_only == true ]]; then
  echo "==> host-only tarball ($host_triple)"
  mise run release:tarball "$host_triple"
else
  echo "==> platform tarballs"
  for triple in \
    x86_64-unknown-linux-gnu \
    aarch64-unknown-linux-gnu \
    x86_64-apple-darwin \
    aarch64-apple-darwin; do
    if ! release_triple_buildable "$triple" "$host_triple"; then
      echo "skip $triple (not buildable on this host)"
      continue
    fi
    mise run release:tarball "$triple"
  done
fi

mise run release:checksums

# Rendering must be idempotent: refuse to tag a tree whose generated files
# would change during publish.
if [[ $dry_run != true && -n $(git status --porcelain) ]]; then
  echo "release assets changed tracked files; commit them before publishing" >&2
  exit 1
fi

# Never ship a key-signed packslip from this script — mise consumers of a
# github.com project expect keyless OIDC. Sign after the release exists.
rm -f dist/packslip.sigstore.json

if [[ $dry_run == true ]]; then
  echo "==> dry-run complete; artifacts in dist/"
  echo "    (packslip is keyless via packslip-sign.yml after a real publish)"
  ls -lh dist/
  exit 0
fi

echo "==> tag $tag"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "tag $tag already exists" >&2
  exit 1
fi
git tag -a "$tag" -m "$tag"
git push origin "refs/tags/$tag"

echo "==> GitHub release"
shopt -s nullglob
assets=(dist/*)
gh release create "$tag" "${assets[@]}" --title "$tag" --notes-file "$notes_file" --verify-tag

echo "==> packslip-sign (keyless CI)"
gh workflow run packslip-sign.yml -f "tag=$tag"
sleep 3
run_id="$(gh run list --workflow=packslip-sign.yml --limit 1 --json databaseId --jq '.[0].databaseId')"
if [[ -z $run_id || $run_id == null ]]; then
  echo "could not find packslip-sign run; check Actions tab" >&2
  exit 1
fi
echo "watching run $run_id"
gh run watch "$run_id" --exit-status

cat <<EOF

Published $tag with keyless packslip.

Install (PC):

  [tools]
  "packslip:github.com/dxkbroom/shcomp" = "$version"
EOF
