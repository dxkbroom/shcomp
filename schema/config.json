{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "tools": {
      "description": "Tools to complete, keyed by any accepted reference (`gh`,\n`cli/cli`, `cli/cli/gh`, a repository URL, or `gh:owner/repo/tool`).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Selection"
      },
      "default": {}
    },
    "settings": {
      "$ref": "#/$defs/Settings",
      "default": {
        "timeout": "5s",
        "fetch": true,
        "prewarm": true,
        "cache_dir": null,
        "data_dir": null,
        "env": {},
        "usage_bin": "usage",
        "shells": [
          "zsh",
          "fish"
        ],
        "log": null,
        "log_file": null
      }
    },
    "registry": {
      "description": "Registry items declared inline, using the registry-item schema.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegistryItem"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Selection": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/SelectionOptions"
        }
      ]
    },
    "SelectionOptions": {
      "type": "object",
      "properties": {
        "aliases": {
          "description": "Extra command names that should receive this tool's completion.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "disabled": {
          "description": "Keep the selection but install nothing for it.",
          "type": "boolean",
          "default": false
        },
        "shells": {
          "description": "Restrict this selection to these shells. Absent means every shell the\ntool supports.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "properties": {
        "timeout": {
          "description": "Timeout for one generator run. Accepts `ms`, `s`, or `m` suffixes.",
          "type": "string",
          "default": "5s"
        },
        "fetch": {
          "description": "Whether `install` may fetch `url` sources.",
          "type": "boolean",
          "default": true
        },
        "prewarm": {
          "description": "Whether `install` and `add` generate each selected tool's script for the\nversion on `PATH`, so the first Tab is warm. `--no-prewarm` overrides.",
          "type": "boolean",
          "default": true
        },
        "cache_dir": {
          "description": "Override the cache directory.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "data_dir": {
          "description": "Override the data directory (where shell shims are installed).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "env": {
          "description": "Environment passed to generators. The process environment is used when\nthis is absent.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "usage_bin": {
          "description": "The `usage` executable that renders `kind = \"usage\"` sources.",
          "type": "string",
          "default": "usage"
        },
        "shells": {
          "description": "Shells `install` manages. Defaults to every shell shcomp supports.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "zsh",
            "fish"
          ]
        },
        "log": {
          "description": "Tracing directives, as `SHCOMP_LOG` takes them. `SHCOMP_LOG` wins.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "log_file": {
          "description": "Append the same events, without color, to this file. `SHCOMP_LOG_FILE`\nwins.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "RegistryItem": {
      "type": "object",
      "properties": {
        "repo": {
          "description": "The workspace this item describes, such as `cli/cli`, a GitHub URL, or\nan SSH URL. Absent for a private item that is addressable only by tool\nname.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "main": {
          "description": "The tool `owner/repo` resolves to. Required when the item has more\nthan one tool.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegistryTool"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tools"
      ]
    },
    "RegistryTool": {
      "type": "object",
      "properties": {
        "name": {
          "description": "The executable name.",
          "type": "string"
        },
        "aliases": {
          "description": "Other names typed at the prompt that should receive this completion.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "shells": {
          "description": "The shells the upstream tool provides completions for, even if shcomp\ndoes not manage a subset yet (e.g. `bash`, `nu`, `pwsh`). Used for\nadvertising and validation; `completions` provides the actual recipes.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "completions": {
          "description": "Completion sources: a shared default that per-shell entries inherit from.",
          "$ref": "#/$defs/Completions",
          "default": {
            "run": null,
            "path": null,
            "url": null,
            "sha256": null,
            "env": {},
            "kind": "native",
            "timeout": null
          }
        },
        "version": {
          "description": "How to discover the version when the install path does not say it.",
          "anyOf": [
            {
              "$ref": "#/$defs/VersionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Completions": {
      "description": "Completion sources for a tool: a shared default that per-shell entries\ninherit from, plus per-shell overrides.\n\nIn TOML, the shared default lives at `[tools.completions]` and per-shell\noverrides at `[tools.completions.<shell>]`. A per-shell entry can be empty\nto inherit the default entirely, or provide partial fields that merge with\nit (override wins for `run`/`path`/`url`; `env` merges; `kind`/`timeout`\noverride when present).",
      "type": "object",
      "properties": {
        "run": {
          "description": "Shared default: argv to run. If present, applies to every shell listed\nin `tools.shells` that does not have its own override.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "path": {
          "description": "Shared default: a completion file path.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "url": {
          "description": "Shared default: a URL to fetch at install time.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sha256": {
          "description": "Shared default: SHA-256 for a URL source.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "env": {
          "description": "Shared default: environment variables for `run`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "kind": {
          "description": "Shared default: source kind.",
          "$ref": "#/$defs/SourceKind",
          "default": "native"
        },
        "timeout": {
          "description": "Shared default: per-source timeout.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/SourceOverride"
      }
    },
    "SourceKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "native"
          ]
        },
        {
          "description": "The script is zsh output that relies on `bashcompinit`.",
          "type": "string",
          "const": "bashcomp"
        },
        {
          "description": "The transport yields a usage KDL spec, and the `usage` CLI renders the\ncompletion from it (ADR-0008).",
          "type": "string",
          "const": "usage"
        }
      ]
    },
    "SourceOverride": {
      "description": "A partial source that merges with a base `Source`. All fields are optional;\n`None` means \"inherit from the base\".",
      "type": "object",
      "properties": {
        "run": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "VersionSpec": {
      "type": "object",
      "properties": {
        "run": {
          "description": "argv that prints the version. Executed without a shell.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regex": {
          "description": "A regular expression; capture group 1 is the version. Without one, the\nfirst version-looking word is used.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "run"
      ]
    }
  }
}
