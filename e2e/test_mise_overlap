#!/usr/bin/env bash
# shcomp owns completion for what the user selected: mise also providing one is
# reported, not obeyed.

mkdir -p mise-install/bin bin
cat >mise-install/bin/fake <<'SH'
#!/bin/sh
printf '#compdef fake\n_fake() { compadd one; }\n'
SH
chmod +x mise-install/bin/fake

cat >bin/mise <<SH
#!/bin/sh
case "\$1 \$2" in
  "ls --json")
    printf '{"fake":[{"version":"1.0.0","install_path":"$PWD/mise-install","installed":true}]}'
    ;;
  "completion zsh")
    printf '#compdef fake\n_fake() { compadd from-mise; }\n'
    ;;
  *)
    exit 1
    ;;
esac
SH
chmod +x bin/mise

cat >"$SHCOMP_CONFIG" <<'TOML'
[tools]
"example/fake" = true

[[registry]]
repo = "example/fake"
main = "fake"

[[registry.tools]]
name = "fake"

[registry.tools.completions.zsh]
run = ["{{ bin }}"]
TOML

export PATH="$PWD/bin:$PWD/mise-install/bin:$PATH"

out=$("$SHCOMP_BIN" install)
assert_not_contains_text "$out" "skipped fake"
assert_file_contains "$SHCOMP_DATA_DIR/zsh/site-functions/_fake" "#compdef fake"

doctor=$("$SHCOMP_BIN" doctor)
assert_contains_text "$doctor" "mise also completes fake"

row=$("$SHCOMP_BIN" ls --json)
assert_contains_text "$row" '"owner": "shcomp+mise"'

ok "shcomp owns the shim when mise also completes the command"
