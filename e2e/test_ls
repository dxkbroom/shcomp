#!/usr/bin/env bash
# ls prints a readable table, --all includes disabled selections, --json carries
# the cache state and the owner, and --no-header drops the header row.

mkdir -p bin
cat >bin/fake <<'SH'
#!/bin/sh
printf '#compdef fake\n_fake() { compadd one; }\n'
SH
chmod +x bin/fake

cat >"$SHCOMP_CONFIG" <<'TOML'
[tools]
"example/fake" = { aliases = ["fk"] }
"example/off" = { disabled = true }
"example/wide" = true

[[registry]]
repo = "example/fake"
main = "fake"

[[registry.tools]]
name = "fake"

[registry.tools.completions.zsh]
run = ["{{ bin }}"]

[[registry]]
repo = "example/wide"
main = "wide"
description = "A stand-in whose description is long enough that eighty columns must wrap it"

[[registry.tools]]
name = "wide"

[registry.tools.completions.zsh]
run = ["{{ bin }}"]

[[registry]]
repo = "example/off"
main = "off"

[[registry.tools]]
name = "off"

[registry.tools.completions.zsh]
run = ["{{ bin }}"]
TOML

export PATH="$PWD/bin:$PATH"

table=$("$SHCOMP_BIN" ls)
assert_contains_text "$table" "Tool"
assert_contains_text "$table" "Cache"
assert_contains_text "$table" "Owner"
assert_contains_text "$table" "fake (fk)"
assert_not_contains_text "$table" "off"

all=$("$SHCOMP_BIN" ls --all)
assert_contains_text "$all" "off (disabled)"

bare=$("$SHCOMP_BIN" ls --no-header)
assert_not_contains_text "$bare" "Tool"

json=$("$SHCOMP_BIN" ls --json)
assert_contains_text "$json" '"state": "missing"'
assert_contains_text "$json" '"owner": "shcomp"'
assert_contains_text "$json" '"disabled": true'

# Readable in 80 columns: every line fits and no word is split.
assert_fits_80() {
  local label="$1" out="$2" line
  out=$(printf '%s\n' "$out" | tr -d '\r' | sed $'s/\x1b\\[[0-9;]*m//g')
  while IFS= read -r line; do
    if (( ${#line} > 80 )); then
      fail "$label: a line is wider than 80 columns: [$line]"
    fi
  done <<<"$out"
  assert_contains_text "$out" "example/wide"
  assert_contains_text "$out" "eighty"
  ok "$label fits 80 columns without splitting words"
}

# A pipe sizes itself from an exported COLUMNS, and stays one line per row
# without one, so grep and awk keep working.
assert_fits_80 "COLUMNS=80 pipe" "$(COLUMNS=80 "$SHCOMP_BIN" ls)"
# Too narrow for every column's longest word: Description gives way rather
# than a word being split.
narrow=$(COLUMNS=60 "$SHCOMP_BIN" ls)
while IFS= read -r line; do
  if (( ${#line} > 60 )); then
    fail "COLUMNS=60: a line is wider than 60 columns: [$line]"
  fi
done <<<"$narrow"
assert_not_contains_text "$narrow" "Description"
assert_contains_text "$narrow" "dxkbroom/shcomp"
unwrapped=$("$SHCOMP_BIN" ls)
assert_contains_text "$unwrapped" "must wrap it"

# A terminal sizes the table itself, whether or not it is styled.
if have_cmd script; then
  for env in "TERM=xterm-256color" "TERM=xterm-256color NO_COLOR=1" "TERM=dumb"; do
    out=$(env -u COLUMNS $env script -qec "stty cols 80; '$SHCOMP_BIN' ls" /dev/null)
    assert_fits_80 "a pty with $env" "$out"
  done
fi

# The Cache column covers both shells; --shell narrows to one.
cat >bin/both <<'SH'
#!/bin/sh
case "$1" in
  zsh) printf '#compdef both\n_both() { compadd zsh-one; }\n' ;;
  fish) printf 'complete -c both -f -a "fish-one"\n' ;;
esac
SH
chmod +x bin/both
cat >"$SHCOMP_CONFIG" <<'TOML'
[tools]
"example/both" = true
"example/fake" = true

[[registry]]
repo = "example/both"
main = "both"

[[registry.tools]]
name = "both"
shells = ["zsh", "fish"]

[registry.tools.completions]
run = ["{{ bin }}", "{{ shell }}"]

[[registry]]
repo = "example/fake"
main = "fake"

[[registry.tools]]
name = "fake"

[registry.tools.completions.zsh]
run = ["{{ bin }}"]
TOML
"$SHCOMP_BIN" load --shell zsh --command both --bin "$PWD/bin/both" >/dev/null
table=$("$SHCOMP_BIN" ls)
assert_contains_text "$table" "Cache (zsh/fish)"
assert_contains_text "$table" "warm/cold"
assert_contains_text "$table" "cold/-"
fish_table=$("$SHCOMP_BIN" ls --shell fish)
assert_contains_text "$fish_table" "both"
assert_not_contains_text "$fish_table" "fake"
assert_not_contains_text "$fish_table" "zsh/fish"
json=$("$SHCOMP_BIN" ls --json --shell fish)
assert_contains_text "$json" '"caches": {'
assert_contains_text "$json" '"fish": {'
json=$("$SHCOMP_BIN" ls --json)
assert_contains_text "$json" '"zsh": {'
assert_contains_text "$json" '"state": "warm"'

# complete-word answers for the user's own shell when it is one shcomp drives.
if have_cmd fish; then
  out=$(SHELL=/usr/bin/fish "$SHCOMP_BIN" complete-word both both "")
  assert_contains_text "$out" "fish-one"
fi
out=$(SHELL=/bin/bash "$SHCOMP_BIN" complete-word both both "" 2>&1 || true)
assert_not_contains_text "$out" "fish-one"

ok "ls table, --all, --no-header, --shell, and --json"
