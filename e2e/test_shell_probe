#!/usr/bin/env bash
# doctor --check asks the real interactive shell for its search path: the
# loading line, a shadowing file earlier on the path, and a stale static
# `_shcomp` from v0.0.1. install prints the loading line only without evidence.

mkdir -p bin early late
cat >bin/fake <<'SH'
#!/bin/sh
case "$1" in
  fish) printf 'complete -c fake -f -a one\n' ;;
  *) printf '#compdef fake\n_fake() { compadd one; }\n' ;;
esac
SH
chmod +x bin/fake
export PATH="$PWD/bin:$PATH"

cat >"$SHCOMP_CONFIG" <<'TOML'
[tools]
"example/fake" = true

[[registry]]
repo = "example/fake"
main = "fake"

[[registry.tools]]
name = "fake"
shells = ["zsh", "fish"]

[registry.tools.completions]
run = ["{{ bin }}", "{{ shell }}"]
TOML

zsh_dir="$SHCOMP_DATA_DIR/zsh/site-functions"
fish_dir="$SHCOMP_DATA_DIR/fish/completions"
out=$("$SHCOMP_BIN" install --no-prewarm)
assert_contains_text "$out" "add this to your shell setup"

if have_cmd zsh; then
  # An empty .zshrc keeps zsh from starting its new-user wizard.
  : >"$HOME/.zshrc"
  check=$("$SHCOMP_BIN" doctor --check)
  assert_contains_text "$check" "an interactive zsh does not have $zsh_dir on fpath; add \`fpath=('$zsh_dir' \$fpath)\` before compinit"

  printf '#compdef fake\n' >early/_fake
  printf '#compdef shcomp\n# @generated by usage-argv for `shcomp __complete_word__ --shell zsh`\n' >late/_shcomp
  cat >"$HOME/.zshrc" <<ZSH
echo "welcome to the test shell"
fpath=('$PWD/early' '$zsh_dir' '$PWD/late' \$fpath)
ZSH
  check=$("$SHCOMP_BIN" doctor --check)
  assert_contains_text "$check" "an interactive zsh has $zsh_dir on fpath (entry 2 of"
  assert_contains_text "$check" "fake: $PWD/early/_fake comes before shcomp's shim on fpath and shadows it"
  assert_contains_text "$check" "$PWD/late/_shcomp is a static shcomp completion left by an older install"
  assert_contains_text "$check" "rm '$PWD/late/_shcomp'"

  # The probe is the evidence: install stops printing the zsh line.
  out=$("$SHCOMP_BIN" install --no-prewarm)
  assert_not_contains_text "$out" "fpath=("
fi

if have_cmd fish; then
  mkdir -p "$XDG_CONFIG_HOME/fish"
  : >"$XDG_CONFIG_HOME/fish/config.fish"
  check=$("$SHCOMP_BIN" doctor --check)
  assert_contains_text "$check" "an interactive fish does not have $fish_dir on fish_complete_path; add \`set -p fish_complete_path '$fish_dir'\` to ~/.config/fish/config.fish"
  out=$("$SHCOMP_BIN" install --no-prewarm)
  assert_contains_text "$out" "set -p fish_complete_path"

  printf "set -p fish_complete_path '%s'\n" "$fish_dir" >"$XDG_CONFIG_HOME/fish/config.fish"
  check=$("$SHCOMP_BIN" doctor --check)
  assert_contains_text "$check" "an interactive fish has $fish_dir on fish_complete_path"
  out=$("$SHCOMP_BIN" install --no-prewarm)
  assert_not_contains_text "$out" "set -p fish_complete_path"
fi

# A shim that loaded is evidence too, with no probe at all.
"$SHCOMP_BIN" clean >/dev/null
out=$("$SHCOMP_BIN" install --no-prewarm)
assert_contains_text "$out" "fpath=("
"$SHCOMP_BIN" load --shell zsh --command fake --bin "$PWD/bin/fake" >/dev/null
out=$("$SHCOMP_BIN" install --no-prewarm)
assert_not_contains_text "$out" "fpath=("

ok "doctor --check probes the interactive shells"
