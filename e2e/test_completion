#!/usr/bin/env bash
# The shell callback answers with tool names, filtered by the word being typed,
# and the generated script knows the protocol.

mkdir -p registry bin
cat >registry/acme.toml <<'TOML'
repo = "acme/tool"
main = "acme"
description = "A private tool"

[[tools]]
name = "acme"

[tools.completions.zsh]
run = ["{{ bin }}"]
TOML
cat >bin/acme <<'SH'
#!/bin/sh
printf '#compdef acme\n_acme() { compadd one; }\n'
SH
chmod +x bin/acme
export SHCOMP_REGISTRY_DIR="$PWD/registry"
export PATH="$PWD/bin:$PATH"

all=$("$SHCOMP_BIN" __complete_word__ --shell zsh --line "shcomp add ")
assert_contains_text "$all" $'gh\tGitHub\'s official command line tool'
assert_contains_text "$all" $'acme\tA private tool'

filtered=$("$SHCOMP_BIN" __complete_word__ --shell zsh --line "shcomp add gh")
assert_contains_text "$filtered" $'gh\tGitHub\'s official command line tool'
assert_not_contains_text "$filtered" "A private tool"

# A reference prefix still works, because the value falls back to the reference.
reference=$("$SHCOMP_BIN" __complete_word__ --shell zsh --line "shcomp add cli/")
assert_contains_text "$reference" $'cli/cli/gh\tGitHub\'s official command line tool'
assert_not_contains_text "$reference" "A private tool"

tool=$("$SHCOMP_BIN" __complete_word__ --shell zsh --line "shcomp complete-word eza")
assert_contains_text "$tool" $'eza\tA modern replacement for ls'

script=$("$SHCOMP_BIN" completion zsh)
assert_contains_text "$script" "__complete_word__"

if "$SHCOMP_BIN" completion zsh --install >/dev/null 2>&1; then
  fail "completion --install should be gone; shcomp install owns the entry"
fi
ok "completion --install is removed"

ok "the completion callback answers tool names"
